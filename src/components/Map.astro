---
import { Image } from 'astro:assets';
import mapImage from '../assets/lysos-map.png';
import mapData from '../map-data.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const { lat, lon, zoom, pin } = mapData;

// Opens whatever maps app the visitor actually has.
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
const biggerHref = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=${zoom}/${lat}/${lon}`;
---

<figure class="mapcard">
  <div
    class="frame"
    id="mapframe"
    data-lat={lat}
    data-lon={lon}
    data-zoom={zoom}
    data-label={t('site.name')}
  >
    <!--
      The baked-in map image is the floor, not the fallback of last resort:
      it renders with no JavaScript at all, so this box can never be empty.
      Dragging and zooming is an upgrade layered on top, on request.
    -->
    <Image
      src={mapImage}
      alt={t('visit.map.alt')}
      widths={[512, 768, 1024]}
      sizes="(min-width: 900px) 900px, 100vw"
      format="webp"
      quality={80}
      loading="lazy"
      class="mapimg"
    />

    <!-- Positioned from the real projected coordinates, not eyeballed. -->
    <div class="pin" style={`left:${pin.leftPct}%; top:${pin.topPct}%`}>
      <span class="dot" aria-hidden="true"></span>
      <span class="label">{t('site.name')}</span>
    </div>

    <div class="live-map" id="lmap"></div>

    <button class="explore" type="button" id="mapexplore" data-fail={t('visit.exploreFail')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M11 8v6M8 11h6M20 20l-4.5-4.5" stroke-linecap="round"></path>
      </svg>
      {t('visit.explore')}
    </button>

    <p class="attrib">{mapData.attribution}</p>
  </div>

  <figcaption class="actions">
    <a class="btn primary" href={directionsHref} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M3 11l19-9-9 19-2-8-8-2z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {t('visit.directions')}
    </a>

    <a class="btn" href={biggerHref} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"></path>
        <path
          d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t('visit.bigmap')}
    </a>

    <p class="coords">{lat}°N · {lon}°E · 560 m</p>
  </figcaption>
</figure>

<script>
  /** Leaflet's stylesheet, fetched only when somebody asks for the map. */
  function loadLeafletCss() {
    return new Promise((resolve, reject) => {
      if (document.querySelector('link[data-leaflet]')) return resolve();
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/leaflet.css';
      link.dataset.leaflet = '';
      link.onload = () => resolve();
      link.onerror = () => reject(new Error('leaflet css failed'));
      document.head.appendChild(link);
    });
  }

  const frame = document.getElementById('mapframe');
  const button = document.getElementById('mapexplore');

  if (frame && button) {
    let starting = false;

    button.addEventListener('click', async () => {
      if (starting) return;
      starting = true;
      button.setAttribute('disabled', '');
      frame.classList.add('loading');

      try {
        // Leaflet is served from our own domain and only downloaded when
        // somebody actually asks to explore — the page itself stays tiny.
        const [{ default: L }] = await Promise.all([import('leaflet'), loadLeafletCss()]);

        // Never hand Leaflet a box that has not been laid out yet: it measures
        // its container exactly once at startup, and a zero measurement means a
        // map stuck on a single tile. Wait for a real size first.
        const target = document.getElementById('lmap');
        await new Promise((resolve) => {
          let tries = 0;
          const check = () => {
            const box = target?.getBoundingClientRect();
            if ((box && box.width > 0 && box.height > 0) || tries++ > 40) resolve();
            else requestAnimationFrame(check);
          };
          check();
        });

        const lat = Number(frame.dataset.lat);
        const lon = Number(frame.dataset.lon);
        const zoom = Number(frame.dataset.zoom);

        const map = L.map('lmap', {
          center: [lat, lon],
          zoom,
          // Otherwise scrolling the page hijacks into zooming the map.
          scrollWheelZoom: false,
          attributionControl: true,
        });

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap contributors',
        }).addTo(map);

        L.marker([lat, lon], {
          icon: L.divIcon({
            className: 'live-pin',
            html: `<span class="dot"></span><span class="label">${frame.dataset.label ?? ''}</span>`,
            iconSize: [15, 15],
            iconAnchor: [7.5, 7.5],
          }),
          keyboard: false,
        }).addTo(map);

        map.whenReady(() => {
          frame.classList.remove('loading');
          frame.classList.add('live');

          // Leaflet measures its container once, at startup. Ours is still
          // fading in at that point, so it would size itself to nothing and
          // load a single tile. Re-measure whenever the box actually changes.
          if (target && 'ResizeObserver' in window) {
            const ro = new ResizeObserver(() => map.invalidateSize());
            ro.observe(target);
          }
          [0, 100, 400, 900].forEach((d) => setTimeout(() => map.invalidateSize(), d));
        });
      } catch {
        // Network blocked, CDN down, whatever — the picture is still there.
        frame.classList.remove('loading');
        button.removeAttribute('disabled');
        button.textContent = button.dataset.fail ?? 'Could not load';
        starting = false;
      }
    });
  }
</script>

<style>
  .mapcard {
    width: min(100%, 60rem);
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(240, 233, 216, 0.03);
    overflow: hidden;
  }

  .frame {
    position: relative;
    /* Tall-ish on phones, wide on desktop — the village stays centred either way */
    aspect-ratio: 4 / 3;
    background: var(--stone-2);
  }

  @media (min-width: 700px) {
    .frame {
      aspect-ratio: 16 / 9;
    }
  }

  .mapimg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* OpenStreetMap ships a bright paper map. Inverting and re-warming it
       turns it into something that belongs in this site's world. */
    filter: invert(0.9) hue-rotate(180deg) brightness(0.92) contrast(0.88) saturate(0.45)
      sepia(0.35);
  }

  .pin {
    position: absolute;
    translate: -50% -50%;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    pointer-events: none;
  }

  .dot {
    display: block;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow:
      0 0 0 5px rgba(219, 164, 65, 0.25),
      0 0 0 12px rgba(219, 164, 65, 0.1),
      0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow:
      0 1px 6px var(--stone),
      0 0 12px var(--stone);
    white-space: nowrap;
  }

  /* — the interactive layer, hidden until asked for — */
  .live-map {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .frame.live .live-map {
    opacity: 1;
    pointer-events: auto;
  }

  /* Once live, the static picture and its pin step aside */
  .frame.live .mapimg,
  .frame.live .pin,
  .frame.live .explore {
    opacity: 0;
    pointer-events: none;
  }

  .explore {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(219, 164, 65, 0.5);
    border-radius: 999px;
    background: rgba(18, 16, 11, 0.82);
    backdrop-filter: blur(6px);
    color: var(--gold);
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      opacity 0.4s ease;
  }

  .explore:hover:not([disabled]) {
    background: var(--gold);
    color: var(--stone);
  }

  .explore[disabled] {
    cursor: progress;
    opacity: 0.65;
  }

  .explore svg {
    width: 17px;
    height: 17px;
  }

  .frame.loading .explore {
    animation: pulse 1.2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.5;
    }
  }

  /* OpenStreetMap's licence requires visible credit. */
  .attrib {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.3rem 0.6rem;
    background: rgba(18, 16, 11, 0.7);
    border-top-left-radius: 8px;
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--ink-soft);
  }

  /* Leaflet supplies its own credit once live */
  .frame.live .attrib {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: rgba(240, 233, 216, 0.03);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .btn:hover {
    color: var(--ink);
    border-color: rgba(240, 233, 216, 0.3);
  }

  .btn.primary {
    border-color: var(--gold);
    background: rgba(219, 164, 65, 0.12);
    color: var(--gold);
  }

  .btn.primary:hover {
    background: var(--gold);
    color: var(--stone);
  }

  .btn svg {
    width: 17px;
    height: 17px;
    flex: none;
  }

  .coords {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (max-width: 620px) {
    .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
    .coords {
      margin-left: 0;
      width: 100%;
      text-align: center;
    }
  }
</style>

<!-- Leaflet's own elements are created at runtime, so they sit outside
     Astro's scoped styles. -->
<style is:global>
  /* Scoped under .mapcard so these beat leaflet.css, which is injected into
     <head> after our styles when the visitor presses Explore. */
  .mapcard .leaflet-container {
    background: var(--stone-2);
    font-family: var(--sans);
  }

  /* Match the live tiles to the baked-in picture */
  .mapcard .leaflet-tile-pane {
    filter: invert(0.9) hue-rotate(180deg) brightness(0.92) contrast(0.88) saturate(0.45)
      sepia(0.35);
  }

  .mapcard .leaflet-control-zoom a {
    background: var(--panel);
    color: var(--gold);
    border-color: var(--line);
  }

  .mapcard .leaflet-control-zoom a:hover {
    background: #2a2417;
    color: var(--gold);
  }

  .mapcard .leaflet-bar {
    border: 1px solid var(--line);
    box-shadow: none;
  }

  .mapcard .leaflet-control-attribution {
    background: rgba(18, 16, 11, 0.75);
    color: var(--ink-soft);
    font-size: 10px;
  }

  .mapcard .leaflet-control-attribution a {
    color: var(--ink-soft);
  }

  .mapcard .live-pin {
    display: grid;
    justify-items: center;
  }

  .mapcard .live-pin .dot {
    display: block;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow:
      0 0 0 5px rgba(219, 164, 65, 0.25),
      0 0 0 12px rgba(219, 164, 65, 0.1),
      0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .mapcard .live-pin .label {
    position: absolute;
    top: 22px;
    left: 50%;
    translate: -50% 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow:
      0 1px 6px var(--stone),
      0 0 12px var(--stone);
    white-space: nowrap;
  }
</style>
