---
import Section from './Section.astro';
import Map from './Map.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const soon = t('soon');
---

<Section
  id="welcome"
  kicker={t('welcome.kicker')}
  title={t('welcome.title')}
  soonLabel={soon}
>
  <p class="lede">{t('welcome.body')}</p>
</Section>

<Section
  id="churches"
  kicker={t('churches.kicker')}
  title={t('churches.title')}
  note={t('churches.note')}
  soonLabel={soon}
  raised
>
  <p class="lede">{t('churches.body')}</p>
</Section>

<Section
  id="sky"
  kicker={t('sky.kicker')}
  title={t('sky.title')}
  note={t('sky.note')}
  soonLabel={soon}
>
  <p class="lede">{t('sky.body')}</p>
</Section>

<Section
  id="discover"
  kicker={t('discover.kicker')}
  title={t('discover.title')}
  soonLabel={soon}
  raised
>
  <div class="cards">
    <article class="card">
      <h3>{t('discover.legends.title')}</h3>
      <p>{t('discover.legends.body')}</p>
    </article>
    <article class="card">
      <h3>{t('discover.food.title')}</h3>
      <p>{t('discover.food.body')}</p>
    </article>
    <article class="card">
      <h3>{t('discover.nature.title')}</h3>
      <p>{t('discover.nature.body')}</p>
    </article>
  </div>
</Section>

<Section
  id="thennow"
  kicker={t('thennow.kicker')}
  title={t('thennow.title')}
  note={t('thennow.note')}
  soonLabel={soon}
>
  <p class="lede">{t('thennow.body')}</p>
</Section>

<Section
  id="wall"
  kicker={t('wall.kicker')}
  title={t('wall.title')}
  note={t('wall.note')}
  soonLabel={soon}
  raised
>
  <p class="lede">{t('wall.body')}</p>
</Section>

<Section
  id="visit"
  kicker={t('visit.kicker')}
  title={t('visit.title')}
  soonLabel={soon}
>
  <div class="cards two">
    <article class="card">
      <h3>{t('visit.getting.title')}</h3>
      <p>{t('visit.getting.body')}</p>
    </article>
    <article class="card">
      <h3>{t('visit.doing.title')}</h3>
      <p>{t('visit.doing.body')}</p>
    </article>
  </div>

  <Map lang={lang} />
</Section>

<Section
  id="ask"
  kicker={t('ask.kicker')}
  title={t('ask.title')}
  note={t('ask.note')}
  soonLabel={soon}
  raised
>
  <p class="lede">{t('ask.body')}</p>
</Section>

<style>
  .lede {
    max-width: var(--measure);
    font-size: var(--step-0);
    color: var(--ink-soft);
    line-height: 1.65;
  }

  /* The body wrapper caps at --measure; cards want the full width */
  .cards {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    width: min(100%, 60rem);
  }

  @media (min-width: 780px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
    .cards.two {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    padding: clamp(1.25rem, 3vw, 1.9rem);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(240, 233, 216, 0.03);
  }

  .card h3 {
    font-size: var(--step-1);
    color: var(--gold-soft);
  }

  .card p {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
</style>
