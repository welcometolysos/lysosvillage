---
import { Image } from 'astro:assets';
import type { Photo } from '../data/gallery';
import type { Lang } from '../i18n/ui';

interface Props {
  photo: Photo;
  lang: Lang;
  /** 'wide' spans the column; 'tall' keeps portrait photos from dominating. */
  shape?: 'wide' | 'tall';
  eager?: boolean;
}

const { photo, lang, shape = 'wide', eager = false } = Astro.props;
---

<figure class:list={['fig', shape]}>
  <Image
    src={photo.image}
    alt={photo.alt[lang]}
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 1100px) 1000px, 94vw"
    format="webp"
    quality={74}
    loading={eager ? 'eager' : 'lazy'}
  />
  {photo.caption && <figcaption>{photo.caption[lang]}</figcaption>}
</figure>

<style>
  .fig {
    width: 100%;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
  }

  .fig :global(img) {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--line);
    /* Pull daylight photographs towards the site's warm-dark world */
    filter: brightness(0.86) saturate(0.78) contrast(1.03) sepia(0.14);
  }

  .fig.wide :global(img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .fig.tall :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 620px) {
    .fig.wide :global(img) {
      aspect-ratio: 4 / 3;
    }
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.35;
    color: var(--gold-soft);
    max-width: var(--measure);
  }
</style>
