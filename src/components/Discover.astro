---
import { Image } from 'astro:assets';
import { figs, forest, digenis } from '../data/gallery';
import { discoveries } from '../data/discover';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const photos: Record<string, ImageMetadata | undefined> = {
  legends: digenis.image,
  nature: forest.image,
  food: figs.image,
};

// The Digenis piece is a square image with a halo at the top and its name
// along the bottom. Cropping it to the card's shape cut both off. It is shown
// whole instead, framed by the card, which is how an icon should sit anyway.
const framed = new Set(['legends']);
---

<ul class="grid">
  {
    discoveries.map((d) => {
      const photo = photos[d.id];
      return (
        <li>
          <details class="find" name="discover">
            <summary>
              {/* Legends gets its own drawn mark: Digenis's footstep in the
                  rock, the thing Lysos actually has. Replaced the moment
                  Kleo photographs the real stone. */}
              {!photo && (
                <div class="plate" aria-hidden="true">
                  <svg viewBox="0 0 200 125" preserveAspectRatio="xMidYMid slice">
                    <circle cx="100" cy="125" r="34" />
                    <circle cx="100" cy="125" r="52" />
                    <circle cx="100" cy="125" r="70" />
                    <circle cx="100" cy="125" r="90" />
                  </svg>
                </div>
              )}

              {photo && (
                <Image
                  src={photo}
                  alt={d.title[lang]}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 900px) 460px, 92vw"
                  format="webp"
                  quality={78}
                  loading="lazy"
                  class:list={['shot', { framed: framed.has(d.id) }]}
                />
              )}

              <div class="meta">
                <h3>{d.title[lang]}</h3>
                <p class="hook">{d.hook[lang]}</p>
                <span class="more">
                  <span class="more-open">{t('churches.readMore')}</span>
                  <span class="more-close">{t('churches.close')}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </summary>

            <div class="detail">
              <p>{d.detail[lang]}</p>

              {/* The Digenis image is newly made, not an artefact. Say so on
                  the page, not only in the code. */}
              {d.id === 'legends' && <p class="made">{digenis.caption?.[lang]}</p>}

              {d.facts && (
                <ul class="facts">
                  {d.facts.map((f) => (
                    <li>{f[lang]}</li>
                  ))}
                </ul>
              )}
            </div>
          </details>
        </li>
      );
    })
  }
</ul>

<style>
  .grid {
    list-style: none;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.4rem);
    width: 100%;
  }

  @media (min-width: 780px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  .find {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(240, 233, 216, 0.03);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .find:hover,
  .find[open] {
    border-color: rgba(219, 164, 65, 0.4);
  }

  summary {
    display: block;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .shot {
    width: 100%;
    /* 16/10 cropped the photographs too hard and beheaded the icon.
       4/3 shows appreciably more of all three. */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: brightness(0.8) saturate(0.7) contrast(1.05) sepia(0.18);
    transition: filter 0.3s ease;
  }

  /* Shown whole rather than cropped, on the card's own dark ground */
  .shot.framed {
    object-fit: contain;
    background: #12100b;
    padding: 0.5rem;
    filter: brightness(0.94) saturate(0.9) contrast(1.02);
  }

  .find:hover .shot.framed,
  .find[open] .shot.framed {
    filter: brightness(1.05) saturate(1) contrast(1.02);
  }

  .find:hover .shot,
  .find[open] .shot {
    filter: brightness(0.94) saturate(0.85) contrast(1.02) sepia(0.08);
  }

  .plate {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 70% 90% at 50% 100%, rgba(219, 164, 65, 0.26), transparent 68%),
      radial-gradient(ellipse 90% 70% at 50% 100%, rgba(193, 89, 47, 0.14), transparent 72%),
      linear-gradient(180deg, #171309 0%, #12100b 100%);
  }

  .plate svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plate circle {
    fill: none;
    stroke: rgba(219, 164, 65, 0.28);
    stroke-width: 0.7;
  }

  .plate circle:first-child {
    stroke: rgba(219, 164, 65, 0.5);
  }

  .plate circle:last-child {
    stroke: rgba(219, 164, 65, 0.13);
  }

  .meta {
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
  }

  h3 {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    color: var(--gold-soft);
  }

  .hook {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .more svg {
    width: 15px;
    height: 15px;
    transition: rotate 0.25s ease;
  }

  .find[open] .more svg {
    rotate: 180deg;
  }

  .more-close {
    display: none;
  }

  .find[open] .more-open {
    display: none;
  }

  .find[open] .more-close {
    display: inline;
  }

  .detail {
    padding: 0 clamp(1.1rem, 2.5vw, 1.5rem) clamp(1.2rem, 2.5vw, 1.5rem);
  }

  .detail > p {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.65;
  }

  .made {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    border-left: 2px solid rgba(219, 164, 65, 0.4);
    background: rgba(219, 164, 65, 0.05);
    color: var(--ink-soft);
    font-size: var(--step-0);
    font-style: italic;
    line-height: 1.5;
  }

  .facts {
    list-style: none;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .facts li {
    display: flex;
    gap: 0.7rem;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .facts li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--gold);
  }
</style>
