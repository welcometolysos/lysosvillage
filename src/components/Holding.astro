---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="holding">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap holding-inner">
    <p class="kicker">{t('hero.kicker')}</p>

    <h1>{t('hero.welcome')}</h1>

    <p class="tagline">{t('site.tagline')}</p>

    <div class="rule" aria-hidden="true"></div>

    <div class="note">
      <p class="kicker note-kicker">{t('building.kicker')}</p>
      <h2>{t('building.title')}</h2>
      <p class="note-body">{t('building.body')}</p>
    </div>
  </div>
</section>

<style>
  .holding {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100svh - 64px);
    overflow: hidden;
    padding-block: clamp(3rem, 10vw, 6rem);
  }

  /* The "lit by the future" light, rising from behind the village */
  .glow {
    position: absolute;
    inset: auto 0 -40% 0;
    height: 90%;
    background: radial-gradient(
      ellipse 70% 100% at 50% 100%,
      rgba(219, 164, 65, 0.22) 0%,
      rgba(193, 89, 47, 0.09) 38%,
      transparent 72%
    );
    pointer-events: none;
    animation: breathe 9s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  .holding-inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: var(--step-3);
    margin-top: 0.6rem;
  }

  .tagline {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--gold-soft);
    max-width: var(--measure);
    margin-top: 1rem;
  }

  .rule {
    width: 4rem;
    height: 2px;
    background: var(--gold);
    margin-block: clamp(2rem, 6vw, 3.5rem);
  }

  .note {
    max-width: var(--measure);
  }

  .note-kicker {
    color: var(--ink-soft);
  }

  h2 {
    font-size: var(--step-2);
    margin-top: 0.5rem;
  }

  .note-body {
    color: var(--ink-soft);
    margin-top: 1rem;
  }
</style>
