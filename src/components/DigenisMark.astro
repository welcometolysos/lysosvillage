---
/**
 * An original illustration for the Legends card.
 *
 * WHY THIS AND NOT A PICTURE OF DIGENIS: every image of the hero is a warrior
 * on a horse, and none of them says anything about Lysos. What Lysos actually
 * has is the place-name «Πατιά του Διγενή» — the footstep of Digenis, pressed
 * into the rock. So that is what this draws.
 *
 * Drawn here in SVG rather than sourced from anywhere: nothing to license,
 * nothing to credit, crisp at any size, and about 2kB. It does not pretend to
 * be a photograph of the real stone — when Kleo photographs that, it replaces
 * this.
 */
---

<div class="mark" aria-hidden="true">
  <svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="dg-stone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#20190f" />
        <stop offset="100%" stop-color="#100e09" />
      </linearGradient>

      <radialGradient id="dg-glow" cx="50%" cy="96%" r="72%">
        <stop offset="0%" stop-color="rgb(219 164 65 / 0.34)" />
        <stop offset="55%" stop-color="rgb(193 89 47 / 0.12)" />
        <stop offset="100%" stop-color="rgb(219 164 65 / 0)" />
      </radialGradient>

      <!-- the print reads as pressed IN, so it is lit from below -->
      <linearGradient id="dg-press" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#0a0906" />
        <stop offset="70%" stop-color="#171208" />
        <stop offset="100%" stop-color="rgb(219 164 65 / 0.55)" />
      </linearGradient>
    </defs>

    <rect width="400" height="250" fill="url(#dg-stone)" />
    <rect width="400" height="250" fill="url(#dg-glow)" />

    <!-- the rising light of the rest of the site, kept as a family resemblance -->
    <g class="arcs">
      <circle cx="200" cy="250" r="72" />
      <circle cx="200" cy="250" r="108" />
      <circle cx="200" cy="250" r="146" />
    </g>

    <!-- the face of the rock -->
    <path
      class="rock"
      d="M62 214 L48 150 L74 96 L128 66 L206 54 L286 66 L338 100 L356 156 L344 214 Z"
    />
    <path class="rock-edge" d="M48 150 L74 96 L128 66 L206 54 L286 66 L338 100 L356 156" />

    <!-- the footstep, pressed into it -->
    <g class="print">
      <!-- sole -->
      <path
        d="M200 96
           c 20 0 31 15 32 33
           c 1 16 -6 25 -6 39
           c 0 15 7 21 6 33
           c -1 15 -13 25 -32 25
           c -19 0 -31 -10 -32 -25
           c -1 -12 6 -18 6 -33
           c 0 -14 -7 -23 -6 -39
           c 1 -18 12 -33 32 -33 Z"
      />
      <!-- toes -->
      <ellipse cx="200" cy="84" rx="9" ry="7" />
      <ellipse cx="216" cy="87" rx="7" ry="6" />
      <ellipse cx="229" cy="93" rx="6" ry="5" />
      <ellipse cx="184" cy="87" rx="7" ry="6" />
      <ellipse cx="171" cy="93" rx="6" ry="5" />
    </g>

    <!-- hairline cracks running out of the print, as if the rock gave way -->
    <g class="cracks">
      <path d="M168 150 L138 138 L112 142" />
      <path d="M232 150 L266 140 L292 146" />
      <path d="M200 226 L196 244" />
    </g>
  </svg>
</div>

<style>
  .mark {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
    background: #12100b;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .arcs circle {
    fill: none;
    stroke: rgb(219 164 65 / 0.16);
    stroke-width: 0.8;
  }

  .rock {
    fill: rgb(240 233 216 / 0.08);
  }

  .rock-edge {
    fill: none;
    stroke: rgb(219 164 65 / 0.45);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .print path,
  .print ellipse {
    fill: url(#dg-press);
    stroke: rgb(219 164 65 / 0.7);
    stroke-width: 1.2;
  }

  .cracks path {
    fill: none;
    stroke: rgb(219 164 65 / 0.3);
    stroke-width: 1;
    stroke-linecap: round;
  }
</style>
