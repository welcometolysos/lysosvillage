---
import { Image } from 'astro:assets';
import { around } from '../data/gallery';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="band" aria-label={t('around.title')}>
  <h3>{t('around.title')}</h3>

  <ul>
    {
      around.map((photo) => (
        <li>
          <figure>
            <Image
              src={photo.image}
              alt={photo.alt[lang]}
              widths={[380, 560, 760]}
              sizes="(min-width: 900px) 340px, 78vw"
              format="webp"
              quality={72}
              loading="lazy"
            />
            {photo.caption && <figcaption>{photo.caption[lang]}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>

  <p class="hint">{t('around.hint')}</p>
</section>

<style>
  .band {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  h3 {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* A swipeable row on phones, a tidy row on desktop. No JavaScript. */
  ul {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 20rem);
    gap: clamp(0.8rem, 2vw, 1.2rem);
    margin-top: 1.1rem;
    padding-bottom: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(219, 164, 65, 0.5) transparent;
  }

  li {
    scroll-snap-align: start;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
    border: 1px solid var(--line);
    filter: brightness(0.86) saturate(0.78) contrast(1.03) sepia(0.14);
    transition: filter 0.3s ease;
  }

  figure:hover :global(img) {
    filter: brightness(1) saturate(0.9) contrast(1.01) sepia(0.05);
  }

  figcaption {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .hint {
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .hint {
      display: none;
    }
  }
</style>
