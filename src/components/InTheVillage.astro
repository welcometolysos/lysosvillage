---
import { places, type PlaceKind } from '../data/places';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons: Record<PlaceKind, string> = {
  eat: 'M5 3v8a3 3 0 0 0 6 0V3M8 11v10M16 3c-1.5 2-2 4-2 6 0 2 1 3 2 3s2-1 2-3c0-2-.5-4-2-6zM18 12v9',
  stay: 'M3 20V8l9-5 9 5v12M9 20v-6h6v6',
  do: 'M4 20l6-9 4 5 3-4 3 8z M8 6.5a1.5 1.5 0 1 0 0-.01',
  village: 'M3 21h18M5 21V9l7-5 7 5v12M10 21v-6h4v6',
};
---

<section class="places" aria-label={t('places.title')}>
  <h3>{t('places.title')}</h3>

  <ul>
    {
      places.map((p) => (
        <li>
          <a
            class="place"
            href={`https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lon}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[p.kind]} />
              </svg>
            </span>

            <span class="text">
              <span class="name">{p.name}</span>
              <span class="what">{p.what[lang]}</span>
              <span class="where">
                {p.fromChurch[lang]}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="caveat">{t('places.caveat')}</p>
</section>

<style>
  .places {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  h3 {
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  ul {
    list-style: none;
    display: grid;
    gap: clamp(0.7rem, 2vw, 1rem);
    margin-top: 1.2rem;
  }

  @media (min-width: 700px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .place {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: clamp(1rem, 2.5vw, 1.3rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(240, 233, 216, 0.03);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .place:hover {
    border-color: rgba(219, 164, 65, 0.45);
    background: rgba(219, 164, 65, 0.06);
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    border: 1px solid rgba(219, 164, 65, 0.3);
    color: var(--gold);
  }

  .icon svg {
    width: 21px;
    height: 21px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .name {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    color: var(--gold-soft);
  }

  .what {
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .where {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .where svg {
    width: 14px;
    height: 14px;
    transition: translate 0.2s ease;
  }

  .place:hover .where svg {
    translate: 3px 0;
  }

  .caveat {
    max-width: var(--measure);
    margin-top: 1.2rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }
</style>
