---
import { places, groups, type Place, type PlaceKind } from '../data/places';
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons: Record<PlaceKind, string> = {
  eat: 'M5 3v8a3 3 0 0 0 6 0V3M8 11v10M16 3c-1.5 2-2 4-2 6 0 2 1 3 2 3s2-1 2-3c0-2-.5-4-2-6zM18 12v9',
  stay: 'M3 20V8l9-5 9 5v12M9 20v-6h6v6',
  do: 'M4 20l6-9 4 5 3-4 3 8z',
  village: 'M3 21h18M5 21V9l7-5 7 5v12M10 21v-6h4v6',
};

/** Coordinates where we have them; otherwise let the map search by name. */
function mapLink(p: Place) {
  const q = p.lat && p.lon ? `${p.lat},${p.lon}` : `${p.name}, Lysos, Cyprus`;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
}
---

<section class="places" aria-label={t('places.title')}>
  <h3 class="kicker">{t('places.title')}</h3>

  {
    groups.map(({ kind, key }) => {
      const inGroup = places.filter((p) => p.kind === kind);
      if (!inGroup.length) return null;
      return (
        <div class="group">
          <h4>{t(key as UIKey)}</h4>
          <ul>
            {inGroup.map((p) => (
              <li>
                <div class="place">
                  <span class="icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d={icons[p.kind]} />
                    </svg>
                  </span>

                  <div class="text">
                    <p class="name">{p.name}</p>
                    <p class="what">{p.what[lang]}</p>
                    <p class="where">{p.fromChurch[lang]}</p>

                    <div class="actions">
                      {p.phone && (
                        <a class="act" href={`tel:${p.phone.replace(/\s/g, '')}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <path
                              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                          {p.phone}
                        </a>
                      )}

                      <a class="act" href={mapLink(p)} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                          <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z" stroke-linecap="round" stroke-linejoin="round" />
                          <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        {t('places.directions')}
                      </a>

                      {p.website && (
                        <a class="act" href={p.website} target="_blank" rel="noopener noreferrer">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <path d="M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          {t('places.website')}
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }

  <p class="caveat">
    {t('places.caveat')}{' '}
    <a href="https://lyssos.org.cy/en/" target="_blank" rel="noopener noreferrer">
      {t('places.source')}
    </a>
  </p>
</section>

<style>
  .places {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .group {
    margin-top: clamp(1.6rem, 4vw, 2.4rem);
  }

  h4 {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--gold-soft);
    margin-bottom: 0.9rem;
  }

  ul {
    list-style: none;
    display: grid;
    gap: clamp(0.7rem, 2vw, 1rem);
  }

  @media (min-width: 760px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1300px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .place {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: clamp(1rem, 2.5vw, 1.3rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(240, 233, 216, 0.03);
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    border: 1px solid rgba(219, 164, 65, 0.3);
    color: var(--gold);
  }

  .icon svg {
    width: 21px;
    height: 21px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .name {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
  }

  .what {
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .where {
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .act {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--gold);
    font-size: var(--step--1);
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .act:hover {
    background: rgba(219, 164, 65, 0.1);
    border-color: rgba(219, 164, 65, 0.45);
  }

  .act svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .caveat {
    max-width: var(--measure);
    margin-top: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .caveat a {
    color: var(--gold);
  }
</style>
